<?xml version="1.0" encoding="UTF-8"?>
<TaskerData sr="" dvi="1" tv="6.3.13">

  <!-- ================================================================
       v1simple JBV1 Tasker Profile

       BEFORE IMPORTING:
       1. Change the SSID below from "v1simple" to your actual
          v1simple Wi-Fi network name if it differs.
       2. Ensure Tasker has Location permission granted (Precise).

       HOW TO IMPORT:
       Tasker → ⋮ (3-dot menu) → Data → Restore → pick this file
       ================================================================ -->

  <Profile sr="prof0" ve="2">
    <cdate>1750000000000</cdate>
    <edate>1750000000000</edate>
    <flags>8</flags>
    <id>1</id>
    <mid0>1</mid0>
    <mid1>2</mid1>
    <nme>v1simple JBV1</nme>
    <!-- Trigger: Wi-Fi Connected to v1simple hotspot -->
    <State sr="con0" ve="2">
      <code>143</code>
      <Str sr="arg0" ve="3">v1simple</Str>
      <Str sr="arg1" ve="3"/>
    </State>
  </Profile>

  <!-- ================================================================
       ENTRY TASK: runs when phone connects to v1simple Wi-Fi
       Loops by calling itself (Perform Task) after each 2-second wait.
       The Exit Task below kills all running instances on disconnect.
       ================================================================ -->
  <Task sr="task1">
    <cdate>1750000000000</cdate>
    <edate>1750000000000</edate>
    <id>1</id>
    <nme>v1simple GPS Push</nme>

    <!-- Action 1: Convert speed m/s → MPH (Do Maths checked) -->
    <Action sr="act0" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3">%LOCSPEED_MPH</Str>
      <Str sr="arg1" ve="3">%LOCSPEED * 2.23694</Str>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="1"/>
    </Action>

    <!-- Action 2: POST GPS data to v1simple -->
    <Action sr="act1" ve="7">
      <code>339</code>
      <Str sr="arg0" ve="3">POST</Str>
      <Str sr="arg1" ve="3">http://192.168.4.1/api/jbv1/update</Str>
      <Str sr="arg2" ve="3">Content-Type:application/json</Str>
      <Str sr="arg3" ve="3"/>
      <Str sr="arg4" ve="3">{"speed":%LOCSPEED_MPH,"heading":"%LOCBEAR","gpsAccuracy":%LOCACC,"satellites":0}</Str>
      <Str sr="arg5" ve="3"/>
      <Int sr="arg6" val="5"/>
      <Int sr="arg7" val="0"/>
      <Int sr="arg8" val="1"/>
      <Str sr="arg9" ve="3"/>
      <Str sr="arg10" ve="3"/>
      <Str sr="arg11" ve="3"/>
      <Str sr="arg12" ve="3"/>
      <Int sr="arg13" val="0"/>
      <Int sr="arg14" val="0"/>
    </Action>

    <!-- Action 3: Wait 2 seconds before next iteration -->
    <Action sr="act2" ve="7">
      <code>30</code>
      <Int sr="arg0" val="2"/>
      <Int sr="arg1" val="0"/>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
    </Action>

    <!-- Action 4: Loop — Perform Task calls this task again (avoids Go To) -->
    <Action sr="act3" ve="7">
      <code>130</code>
      <Str sr="arg0" ve="3">v1simple GPS Push</Str>
      <Int sr="arg1" val="10"/>
      <Str sr="arg2" ve="3"/>
      <Str sr="arg3" ve="3"/>
      <Str sr="arg4" ve="3"/>
      <Int sr="arg5" val="0"/>
      <Int sr="arg6" val="0"/>
    </Action>

  </Task>

  <!-- ================================================================
       EXIT TASK: runs when phone disconnects from v1simple Wi-Fi.
       Kills all running instances of the push loop.
       ================================================================ -->
  <Task sr="task2">
    <cdate>1750000000000</cdate>
    <edate>1750000000000</edate>
    <id>2</id>
    <nme>v1simple GPS Stop</nme>

    <Action sr="act0" ve="7">
      <code>137</code>
      <Str sr="arg0" ve="3">v1simple GPS Push</Str>
      <Int sr="arg1" val="0"/>
    </Action>

  </Task>

</TaskerData>
